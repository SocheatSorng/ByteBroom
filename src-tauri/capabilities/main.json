{
  "identifier": "main",
  "description": "The ByteBroom window may call ByteBroom's own commands and nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-scan-state",
    "allow-preview",
    "allow-clean",
    "allow-pick-move-destination",
    "allow-open-recycle-bin",
    "allow-red-actions",
    "allow-run-red-action",
    "allow-history",
    "allow-put-back",
    "allow-clear-history",
    "allow-update-check",
    "allow-install-update"
  ]
}
